[Unit]
Description=RDK X5 robot bringup
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=ROS_DOMAIN_ID=20
ExecStart=/bin/bash -lc 'source /opt/tros/humble/setup.bash && source /home/root/robot_ws/install/setup.bash && ros2 launch robot_bringup robot.launch.py'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target